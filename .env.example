# ---------------------------------------------------------------------------
# Copy to `.env` for local development. Never commit `.env`.
# On your host (Vercel, Fly, Railway, a VPS…) set the same keys as environment
# variables. Everything marked REQUIRED IN PRODUCTION is checked at boot by
# src/instrumentation.ts — the server refuses to start if it is wrong.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Pooled connection, used by the app.
#   local        : postgresql://postgres:postgres@localhost:5432/party_planner?schema=public
#   Neon/Supabase: postgresql://user:pass@host/db?sslmode=require&pgbouncer=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/party_planner?schema=public"

# Direct connection, used by `prisma migrate` only. Transaction-mode poolers do
# not support the DDL and advisory locks migrations need. Locally this is simply
# the same value as DATABASE_URL; on Neon/Supabase use their *direct* string.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/party_planner?schema=public"

# --- Public origin ----------------------------------------------------------
# REQUIRED IN PRODUCTION (or set AUTH_TRUST_HOST behind a proxy you control).
#
# APP_URL is read at RUNTIME and is the canonical answer. It is what builds the
# invitation links in notification emails, the URL inside .ics files, and the
# "copy link" button. Change the domain, restart — no rebuild needed.
APP_URL="http://localhost:3000"

# NEXT_PUBLIC_APP_URL is inlined at BUILD time and is only used for <meta> tags
# (metadataBase / Open Graph). Change it and you must redeploy. Usually the same
# value as APP_URL.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Auth.js ----------------------------------------------------------------
# REQUIRED. Generate with: openssl rand -base64 32
# Rotating it signs every existing session out.
AUTH_SECRET="replace-me-with-a-32-byte-random-string"

# REQUIRED when self-hosting in production (Docker, a VPS, `next start` behind
# nginx or Caddy). Auth.js will not trust the request Host header otherwise and
# sign-in fails with "There was a problem with the server configuration".
# It also lets the app derive its own origin from forwarded headers when APP_URL
# is unset. Only set it when something in front of the app overwrites Host and
# X-Forwarded-*; otherwise a forged header ends up in links you email out.
# Vercel is detected automatically and development always trusts localhost.
# AUTH_TRUST_HOST=1

# Optional Google sign-in. Leave blank to hide the button entirely.
# Authorised redirect URI: https://your-domain.com/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Set to "false" to close public self-service registration (invite-only instance).
ALLOW_PUBLIC_REGISTRATION="true"

# --- Email notifications ----------------------------------------------------
# EMAIL_PROVIDER: "resend" | "smtp" | "console"
# "console" only prints to the log — fine for development, a warning at boot in
# production, because it means nobody receives anything.
EMAIL_PROVIDER="console"
EMAIL_FROM="Party Planner <noreply@example.com>"

# Resend (EMAIL_PROVIDER=resend). Verify your sending domain first.
RESEND_API_KEY=""

# SMTP / Nodemailer (EMAIL_PROVIDER=smtp)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""

# --- File uploads -----------------------------------------------------------
# STORAGE_DRIVER: "local" | "vercel-blob"
# "local" writes to ./public/uploads. Works for `next dev` and for any container
# with a persistent volume mounted there. It CANNOT work on Vercel (read-only,
# per-invocation filesystem) — the app refuses to boot in that combination.
STORAGE_DRIVER="local"
# Created automatically by Vercel when you add Blob storage to the project.
BLOB_READ_WRITE_TOKEN=""

# --- Rate limiting (optional but recommended in production) -----------------
# Without these, rate limits are counted per process. On serverless or across
# several containers that means the real budget is limit × instances. Point
# these at an Upstash Redis database for one shared counter.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Header carrying the real client IP, if your platform sets one that cannot be
# forged end-to-end. Cloudflare: cf-connecting-ip. Leave unset to use
# x-real-ip / x-forwarded-for.
# TRUSTED_PROXY_HEADER="cf-connecting-ip"
