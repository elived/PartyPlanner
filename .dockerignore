# Keep the build context small and, more importantly, keep secrets and local
# state out of the image entirely.
.env
.env.*
!.env.example

node_modules
.next
.pgdata
.git
.github
.vercel
.claude

public/uploads/*
!public/uploads/.gitkeep

*.log
*.tsbuildinfo
.DS_Store
README.md
docker-compose*.yml
Dockerfile
